# Discord bot credentials
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: guild ID for instant slash command registration during testing
# Remove or leave blank to register commands globally (takes ~1 hour)
DISCORD_GUILD_ID=

# Comma-separated Discord user IDs allowed to run /panel
ADMIN_IDS=123456789012345678,987654321098765432

# DonutSMP API — get your key from the DonutSMP server
DONUTSMP_API_KEY=
# The in-game name users must send their DonutSMP money to
DONUTSMP_RECEIVER_IGN=

# LTC wallet seed phrase (12 or 24 words) — keep this secret!
LTC_SEED_PHRASE=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12

# Price per 1,000,000 DonutSMP money in USD
# Bot will convert to LTC automatically using live CoinGecko rates
PRICE_PER_MILLION_USD=2.00

# How long buyers have to send their DonutSMP payment (in minutes)
PAYMENT_TIMEOUT_MINUTES=5

# Optional: set to true to enable extra queue progress logs for debugging
VERBOSE_LOGS=false

# Optional: BlockCypher API token for higher rate limits (free at blockcypher.com)
BLOCKCYPHER_TOKEN=

# MongoDB connection string for storing user settings (IGN + LTC address)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/autosell?retryWrites=true&w=majority

# Fallback text channel for bot activity logs when no category-specific channel is set
LOGS_CHANNEL_ID=

# Optional: auto-sell trade lifecycle logs. Donut/LTC payment logs fall back here before LOGS_CHANNEL_ID.
AUTOSELL_LOGS_CHANNEL_ID=

# Optional: categorized payment log channels. If blank, falls back to AUTOSELL_LOGS_CHANNEL_ID, then LOGS_CHANNEL_ID.
DONUT_PAYMENT_LOGS_CHANNEL_ID=
LTC_PAYMENT_LOGS_CHANNEL_ID=

# Optional: invite reward command/admin logs and member join/leave tracking logs.
INVITE_LOGS_CHANNEL_ID=
JOIN_LOGS_CHANNEL_ID=

# Optional: ticket/giveaway close logs and TXT+HTML transcript files
# If blank, transcript delivery uses TICKET_LOGS_CHANNEL_ID, LOGS_CHANNEL_ID, or creates/reuses #ticket-transcripts.
TICKET_TRANSCRIPTS_CHANNEL_ID=
TICKET_LOGS_CHANNEL_ID=
GIVEAWAY_LOGS_CHANNEL_ID=

# Channel ID of a voice channel — bot will rename it to show current balance e.g. "$10.27 Bot Balance"
VOICE_CHANNEL_ID=

# Optional: Discord role ID that can see all ticket channels
TICKET_STAFF_ROLE_ID=

# Optional: Discord role ID assigned to users after they complete an auto-sell (DonutSMP money → LTC)
CLIENT_ROLE_ID=
